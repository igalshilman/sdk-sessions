{
  "name": "@restatedev/agents",
  "version": "0.11.2",
  "description": "Agent frameworks in Restate virtual objects, their state in the object's SQL database: pi, OpenCode, LangGraph, Claude (Anthropic SDK) and DeepSeek Harness; and agentlib, journaled",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restatedev/sdk-sessions.git",
    "directory": "packages/agents"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./agentlib": "./src/agentlib/index.ts",
    "./claude": "./src/claude/index.ts",
    "./client": "./src/client.ts",
    "./deepseek": "./src/deepseek/index.ts",
    "./langgraph": "./src/langgraph/index.ts",
    "./opencode": "./src/opencode/index.ts",
    "./opencode/db": "./src/opencode/db.ts",
    "./pi": "./src/pi/index.ts",
    "./pi/storage": "./src/pi/storage.ts",
    "./test/*": "./test/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./agentlib": {
        "types": "./dist/agentlib/index.d.ts",
        "default": "./dist/agentlib/index.js"
      },
      "./claude": {
        "types": "./dist/claude/index.d.ts",
        "default": "./dist/claude/index.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./deepseek": {
        "types": "./dist/deepseek/index.d.ts",
        "default": "./dist/deepseek/index.js"
      },
      "./langgraph": {
        "types": "./dist/langgraph/index.d.ts",
        "default": "./dist/langgraph/index.js"
      },
      "./opencode": {
        "types": "./dist/opencode/index.d.ts",
        "default": "./dist/opencode/index.js"
      },
      "./opencode/db": {
        "types": "./dist/opencode/db.d.ts",
        "default": "./dist/opencode/db.js"
      },
      "./pi": {
        "types": "./dist/pi/index.d.ts",
        "default": "./dist/pi/index.js"
      },
      "./pi/storage": {
        "types": "./dist/pi/storage.d.ts",
        "default": "./dist/pi/storage.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "build:ts": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build:ts"
  },
